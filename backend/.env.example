# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Never commit the real .env file.

# AI Provider
# Options: groq, nvidia, gemini
AI_PROVIDER=groq

# Optional fallback provider.
# Use "none" if you do not want fallback calls.
AI_FALLBACK_PROVIDER=nvidia

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# NVIDIA NIM / Nemotron
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Gemini fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Deepgram speech-to-text for mock interview answers
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_PARAGRAPHS=false
DEEPGRAM_UTTERANCES=false

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:5000
DATABASE_URL=sqlite:///skillify.db
RATELIMIT_STORAGE_URI=memory://

# Public job-market data (no API key required)
JOB_MARKET_API_URL=https://www.arbeitnow.com/api/job-board-api
JOB_MARKET_CACHE_SECONDS=900
JOB_MARKET_PAGES=3
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
# Remotive recommends infrequent refreshes; six hours avoids unnecessary calls.
REMOTIVE_CACHE_SECONDS=21600
THE_MUSE_API_URL=https://www.themuse.com/api/public/jobs
# Optional for local testing, recommended for deployed usage and higher limits.
THE_MUSE_API_KEY=
THE_MUSE_CACHE_SECONDS=3600
THE_MUSE_PAGES=5

# Optional: Set custom port for Flask
# FLASK_PORT=5000
